# ── Aria AI concierge (Google Gemini) ────────────────────────────────
# Server-side only — never exposed to the browser. The chat calls Gemini
# through the /api/chat route. Without a key, Aria falls back to built-in
# rule-based answers so the site still works.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the model (default: gemini-flash-latest, which auto-tracks
# the current Gemini flash). Some keys have zero free-tier quota on the pinned
# gemini-2.0-flash but work on gemini-flash-latest.
GEMINI_MODEL=gemini-flash-latest

# ── SEO ──────────────────────────────────────────────────────────────
# Your canonical production origin (no trailing slash). Powers canonical
# URLs, Open Graph, sitemap, robots and JSON-LD. On Vercel this auto-falls
# back to your production URL, but set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=https://luxora-estates.vercel.app

# Google Search Console verification token (the content="..." value from the
# HTML-tag verification method). Optional — leave blank until you verify.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
